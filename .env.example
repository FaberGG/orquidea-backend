
# Copiar a .env (que NO se sube al repositorio) y ajustar valores.
# Lo leen tanto docker compose como la aplicación al correr desde el IDE.

# Puerto de la API en tu máquina
PUERTO_API=8080

# PORT lo proporcionan automáticamente Render y Fly.io.
# En local se utiliza PUERTO_API como alternativa.

# Base de datos
POSTGRES_DB=orquidea_db
POSTGRES_USER=orquidea_user
POSTGRES_PASSWORD=orquidea_pass
POSTGRES_PUERTO=5432

# URL JDBC completa (opcional, para Supabase o Fly Postgres).
# Si no se configura, se utiliza la conexión local predeterminada.
# POSTGRES_URL=jdbc:postgresql://localhost:5432/orquidea_db

# Máximo de conexiones simultáneas a PostgreSQL
POSTGRES_POOL_MAXIMO=10

# JWT: mínimo 32 caracteres.
# Genera uno propio, p. ej.: openssl rand -base64 48
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio-de-desarrollo
JWT_EXPIRACION=8h

# Primer superadministrador (solo se crea si aún no existe ninguno)
SUPERADMIN_NOMBRE=Super
SUPERADMIN_APELLIDO=Administrador
SUPERADMIN_CORREO=superadmin@orquidea.local
SUPERADMIN_CONTRASENA=cambia-esta-clave

# Máximo de administradores que puede crear el superadministrador (HU-4)
ADMINISTRADORES_LIMITE=3

# Almacenamiento de archivos (S3).
# En desarrollo: RustFS local de docker-compose.
# En producción (Cloudflare R2):
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_URL_PUBLICA=<dominio público del bucket>
# STORAGE_CREAR_BUCKET=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=orquidea-storage
STORAGE_SECRET_KEY=orquidea-storage-secreto
STORAGE_BUCKET=orquidea
STORAGE_URL_PUBLICA=http://localhost:9000/orquidea
STORAGE_CREAR_BUCKET=true

# Optimización de las fotos al subirlas
# Ver docs/api/procesamiento-de-fotos.md
STORAGE_IMAGEN_ANCHO_MAXIMO=1600
STORAGE_IMAGEN_ANCHO_MINIATURA=480
STORAGE_IMAGEN_CALIDAD_JPEG=0.85

# Límites de procesamiento de imágenes
STORAGE_IMAGEN_MEGAPIXELES_MAXIMOS=50
STORAGE_IMAGEN_PROCESAMIENTOS_SIMULTANEOS=2

# Fotos subidas antes de la optimización:
# no, simular (solo informa en el log cuánto se ahorraría) o aplicar.
# Aplicar reemplaza las fotos y no se puede deshacer:
# respalda el bucket antes.
STORAGE_REPROCESAR_FOTOS=no

# pgAdmin
PGADMIN_CORREO=admin@orquidea.local
PGADMIN_CONTRASENA=admin

# Correo (API HTTP de Resend).
# Sin RESEND_API_KEY los correos no se envían:
# solo se registran en el log.
# El remitente debe ser de un dominio verificado en Resend.
# Para probar sin dominio usa onboarding@resend.dev.
# Solo entrega a la dirección de tu propia cuenta de Resend.
RESEND_API_KEY=
MAIL_REMITENTE=Humedal La Orquidea <onboarding@resend.dev>

# Swagger
# true = habilitado en desarrollo.
# false = deshabilitado en producción.
SWAGGER_HABILITADO=true
