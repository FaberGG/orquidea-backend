# Copiar a .env (que NO se sube al repositorio) y ajustar valores.
# Lo leen tanto docker compose como la aplicación al correr desde el IDE.

# Puerto de la API en tu máquina (cámbialo si el 8080 ya está ocupado)
PUERTO_API=8080

# Base de datos
POSTGRES_DB=orquidea_db
POSTGRES_USER=orquidea_user
POSTGRES_PASSWORD=orquidea_pass
POSTGRES_PUERTO=5432

# JWT: mínimo 32 caracteres. Genera uno propio, p. ej.: openssl rand -base64 48
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio-de-desarrollo
JWT_EXPIRACION=8h

# Primer superadministrador (solo se crea si aún no existe ninguno)
SUPERADMIN_NOMBRE=Super
SUPERADMIN_APELLIDO=Administrador
SUPERADMIN_CORREO=superadmin@orquidea.local
SUPERADMIN_CONTRASENA=cambia-esta-clave

# Almacenamiento de archivos (S3). En desarrollo: RustFS local de docker-compose.
# En producción (Cloudflare R2): STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# STORAGE_REGION=auto, STORAGE_URL_PUBLICA=<dominio público del bucket>, STORAGE_CREAR_BUCKET=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=orquidea-storage
STORAGE_SECRET_KEY=orquidea-storage-secreto
STORAGE_BUCKET=orquidea
STORAGE_URL_PUBLICA=http://localhost:9000/orquidea
STORAGE_CREAR_BUCKET=true

# pgAdmin
PGADMIN_CORREO=admin@orquidea.local
PGADMIN_CONTRASENA=admin
