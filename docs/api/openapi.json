{"openapi":"3.1.0","info":{"title":"API Humedal La Orquídea","description":"Backend de la Plataforma de Educación Ambiental e Interactividad del Humedal La Orquídea","version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"jwt":[]}],"tags":[{"name":"Autenticación","description":"Inicio de sesión y datos de la sesión actual (HU-1)"},{"name":"Componentes del humedal","description":"Información de los componentes del humedal (HU-14, HU-15)"},{"name":"Administradores","description":"Gestión de cuentas de administrador, solo SUPERADMINISTRADOR (HU-5)"},{"name":"Reportes de avistamiento","description":"Reportes ciudadanos: creación (HU-18), revisión (HU-19) y foro público (HU-20)"},{"name":"Anuncios","description":"Gestión y consulta de anuncios del humedal (HU-16, HU-17)"},{"name":"Fichas taxonómicas","description":"Fichas de especies del humedal (HU-7, HU-8)"}],"paths":{"/api/fichas-taxonomicas/{id}":{"get":{"tags":["Fichas taxonómicas"],"summary":"Consultar ficha taxonómica","description":"Público.","operationId":"obtenerPorId","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Ficha encontrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TaxonDto"}}}},"404":{"description":"La ficha no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]},"put":{"tags":["Fichas taxonómicas"],"summary":"Editar ficha taxonómica","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Reemplaza todos los datos de la ficha con el mismo formulario de la creación; la foto es opcional y, si no se envía, se conserva la actual. Ante un 200 el cliente muestra: 'La ficha se actualizó correctamente.'","operationId":"actualizar","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/TaxonRequest"}}}},"responses":{"200":{"description":"Ficha actualizada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TaxonDto"}}}},"400":{"description":"Debes completar todos los campos obligatorios. / El formato de la imagen no es válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"404":{"description":"La ficha no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"Otra ficha ya usa ese nombre científico","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"413":{"description":"La imagen supera el tamaño máximo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/componentes/{tipo}":{"get":{"tags":["Componentes del humedal"],"summary":"Consultar un componente del humedal","description":"Público. Devuelve la descripción y las fotos del componente. Si todavía no tiene información responde 200 con tieneContenido=false, descripcion nula y fotos vacío; el cliente muestra: 'La información de esta sección estará disponible próximamente.'","operationId":"obtener","parameters":[{"name":"tipo","in":"path","description":"Componente: INSECTOS, AVES, FLORA u OTROS (en mayúsculas)","required":true,"schema":{"type":"string","enum":["INSECTOS","AVES","FLORA","OTROS"]},"example":"AVES"}],"responses":{"200":{"description":"Componente encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ComponentDto"}}}},"404":{"description":"El componente no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]},"put":{"tags":["Componentes del humedal"],"summary":"Editar el texto de un componente","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Reemplaza nombre y descripción; las fotos tienen sus propios endpoints. Ante un 200 el cliente muestra: 'El contenido del componente se actualizó correctamente.'","operationId":"actualizar_1","parameters":[{"name":"tipo","in":"path","description":"Componente: INSECTOS, AVES, FLORA u OTROS (en mayúsculas)","required":true,"schema":{"type":"string","enum":["INSECTOS","AVES","FLORA","OTROS"]},"example":"AVES"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComponentUpdateRequest"}}},"required":true},"responses":{"200":{"description":"Componente actualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ComponentDto"}}}},"400":{"description":"Debes completar todos los campos obligatorios.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"404":{"description":"El componente no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/administradores/{id}":{"put":{"tags":["Administradores"],"summary":"Editar o inhabilitar un administrador","description":"Reemplaza nombre, apellido, correo, teléfono y estado (habilitado) de la cuenta. Ante un 200 el cliente muestra: 'Los cambios se guardaron correctamente.'","operationId":"actualizar_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdministratorUpdateRequest"}}},"required":true},"responses":{"200":{"description":"Administrador actualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdministratorDto"}}}},"400":{"description":"Debes completar todos los campos obligatorios. / Ingresa un correo electrónico válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"403":{"description":"El usuario no es superadministrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"404":{"description":"El administrador no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"409":{"description":"Este correo ya está registrado.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}}}}},"/api/reportes-avistamiento":{"get":{"tags":["Reportes de avistamiento"],"summary":"Foro de avistamientos","description":"Público. Solo reportes APROBADOS, los más recientes primero. Si no hay ninguno responde una página vacía y el cliente muestra: 'Aún no hay avistamientos publicados.'","operationId":"listarAprobados","parameters":[{"name":"pagina","in":"query","description":"Número de página, desde 0","required":false,"schema":{"type":"integer","format":"int32","default":0},"example":0},{"name":"tamano","in":"query","description":"Tamaño de página, máximo 50","required":false,"schema":{"type":"integer","format":"int32","default":20},"example":20}],"responses":{"200":{"description":"Página de reportes aprobados","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseOccurrenceDto"}}}}},"security":[]},"post":{"tags":["Reportes de avistamiento"],"summary":"Crear reporte de avistamiento","description":"Solo USUARIO_REGISTRADO. Formulario multipart: la descripción es obligatoria; reino y clasificación sin valor quedan como desconocidos; la foto es opcional (jpg o png, máx. 10 MB). El autor es el usuario autenticado. Ante un 201 el cliente muestra: 'Tu reporte fue enviado y será revisado por un administrador.'","operationId":"crear","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/OccurrenceRequest"}}}},"responses":{"201":{"description":"Reporte creado en estado PENDIENTE","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OccurrenceDto"}}}},"200":{"description":"Ya existía un reporte propio con ese id; se devuelve sin duplicarlo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OccurrenceDto"}}}},"400":{"description":"La descripción es obligatoria. / El formato de la imagen no es válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es USUARIO_REGISTRADO","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"Otro usuario ya registró un reporte con ese id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"413":{"description":"La imagen supera el tamaño máximo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/reportes-avistamiento/{id}/rechazar":{"post":{"tags":["Reportes de avistamiento"],"summary":"Rechazar reporte","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. El reporte sale de la cola y no se publica.","operationId":"rechazar","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Reporte RECHAZADO","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OccurrenceDto"}}}},"404":{"description":"El reporte no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"El reporte ya fue revisado.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/reportes-avistamiento/{id}/aprobar":{"post":{"tags":["Reportes de avistamiento"],"summary":"Aprobar reporte","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Publica el reporte en el foro.","operationId":"aprobar","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Reporte APROBADO","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OccurrenceDto"}}}},"404":{"description":"El reporte no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"El reporte ya fue revisado.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/fichas-taxonomicas":{"get":{"tags":["Fichas taxonómicas"],"summary":"Listar fichas taxonómicas","description":"Público. Ordenadas por nombre común. Con el parámetro categoria (AVE, PLANTA o INSECTO) devuelve solo las de ese listado; sin él, todas. Si la categoría no tiene fichas responde una lista vacía y el cliente muestra: 'Aún no hay especies registradas en esta categoría.'","operationId":"listar","parameters":[{"name":"categoria","in":"query","description":"Categoría a consultar; si se omite, se listan todas","required":false,"schema":{"type":"string","enum":["AVE","PLANTA","INSECTO"]},"example":"AVE"}],"responses":{"200":{"description":"Listado de fichas (vacío si no hay ninguna)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TaxonDto"}}}}},"400":{"description":"El valor del parámetro 'categoria' no es válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]},"post":{"tags":["Fichas taxonómicas"],"summary":"Crear ficha taxonómica","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Formulario multipart con los datos y la foto (jpg o png, máx. 10 MB).","operationId":"crear_1","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/TaxonRequest"}}}},"responses":{"201":{"description":"Ficha creada y publicada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TaxonDto"}}}},"400":{"description":"Debes completar todos los campos obligatorios. / El formato de la imagen no es válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"Ya existe una ficha con ese nombre científico","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"413":{"description":"La imagen supera el tamaño máximo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/componentes/{tipo}/fotos":{"post":{"tags":["Componentes del humedal"],"summary":"Agregar una foto a un componente","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Formulario multipart con el campo 'foto' (jpg o png, máx. 10 MB). Cada componente admite como máximo 10 fotos. Devuelve el componente completo con su lista de fotos actualizada.","operationId":"agregarFoto","parameters":[{"name":"tipo","in":"path","description":"Componente: INSECTOS, AVES, FLORA u OTROS (en mayúsculas)","required":true,"schema":{"type":"string","enum":["INSECTOS","AVES","FLORA","OTROS"]},"example":"AVES"}],"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"foto":{"type":"string","format":"binary","description":"Foto jpg o png, máximo 10 MB"}}}}}},"responses":{"201":{"description":"Foto agregada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ComponentDto"}}}},"400":{"description":"Debes seleccionar una imagen. / El formato de la imagen no es válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"404":{"description":"El componente no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"El componente ya tiene el máximo de fotos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"413":{"description":"La imagen supera el tamaño máximo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/autenticacion/restablecer-contrasena":{"post":{"tags":["Autenticación"],"summary":"Restablecer contraseña","description":"Cambia la contraseña con el código recibido por correo. El código es de un solo uso y se invalida al vencer o tras varios intentos fallidos.","operationId":"restablecerContrasena","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PasswordResetRequest"}}},"required":true},"responses":{"204":{"description":"Contraseña actualizada"},"400":{"description":"Datos inválidos, o código incorrecto o vencido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]}},"/api/autenticacion/registro":{"post":{"tags":["Autenticación"],"summary":"Registrar nuevo usuario","description":"Registra un nuevo usuario en el sistema y asigna el rol de usuario registrado.","operationId":"registrarUsuario","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}},"required":true},"responses":{"201":{"description":"Registro exitoso creado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RegisterResponse"}}}},"400":{"description":"Los datos enviados no son válidos.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"409":{"description":"El correo electrónico ya está registrado.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]}},"/api/autenticacion/recuperar-contrasena":{"post":{"tags":["Autenticación"],"summary":"Solicitar código de recuperación","description":"Envía un código de 6 dígitos al correo si pertenece a una cuenta habilitada. Responde igual aunque el correo no esté registrado, para no revelar qué cuentas existen.","operationId":"solicitarCodigoRecuperacion","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PasswordRecoveryRequest"}}},"required":true},"responses":{"204":{"description":"Solicitud recibida"},"400":{"description":"El correo es obligatorio y debe ser válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]}},"/api/autenticacion/iniciar-sesion":{"post":{"tags":["Autenticación"],"summary":"Iniciar sesión","description":"Valida correo y contraseña y devuelve un JWT junto con el rol del usuario.","operationId":"iniciarSesion","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Ingreso exitoso","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"400":{"description":"Ambos campos son obligatorios.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Correo o contraseña incorrectos.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}},"security":[]}},"/api/anuncios":{"get":{"tags":["Anuncios"],"summary":"Listar anuncios","description":"Público. Devuelve los anuncios ordenados por fecha de publicación, del más reciente al más antiguo. Si no hay anuncios devuelve una lista vacía y el cliente muestra: 'Aún no hay anuncios publicados.'","operationId":"obtenerAnuncios","responses":{"200":{"description":"Listado de anuncios (puede estar vacío)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AnnouncementResponse"}}}}}},"security":[]},"post":{"tags":["Anuncios"],"summary":"Publicar anuncio","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Título y contenido son obligatorios. El anuncio queda visible para todos los usuarios.","operationId":"ingresarAnuncio","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnnouncementRequest"}}},"required":true},"responses":{"201":{"description":"Anuncio publicado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AnnouncementResponse"}}}},"400":{"description":"Debes completar el título del anuncio. / Debes completar el contenido del anuncio.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es administrador o superadministrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/administradores/{id}/revocar-acceso":{"post":{"tags":["Administradores"],"summary":"Revocar el acceso de administrador","description":"Degrada la cuenta a USUARIO_REGISTRADO y notifica al afectado por correo.","operationId":"revocarAcceso","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Acceso revocado; la cuenta quedó como usuario registrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdministratorDto"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"403":{"description":"El usuario no es superadministrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"404":{"description":"El administrador no existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"409":{"description":"No puedes revocar el único superadministrador de la plataforma.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}}}}},"/api/administradores/registrarAdmin":{"post":{"tags":["Administradores"],"summary":"Registrar un nuevo administrador","description":"Crea una nueva cuenta de administrador con los datos proporcionados.","operationId":"registrar","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}},"required":true},"responses":{"201":{"description":"Administrador registrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RegisterResponse"}}}},"400":{"description":"Debes completar todos los campos obligatorios. / Ingresa un correo electrónico válido.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"403":{"description":"El usuario no es superadministrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}},"409":{"description":"Este correo ya está registrado.","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponse"}}}}}}},"/api/reportes-avistamiento/pendientes":{"get":{"tags":["Reportes de avistamiento"],"summary":"Cola de revisión","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. Reportes PENDIENTES, los más antiguos primero.","operationId":"listarPendientes","parameters":[{"name":"pagina","in":"query","description":"Número de página, desde 0","required":false,"schema":{"type":"integer","format":"int32","default":0},"example":0},{"name":"tamano","in":"query","description":"Tamaño de página, máximo 50","required":false,"schema":{"type":"integer","format":"int32","default":20},"example":20}],"responses":{"200":{"description":"Página de reportes pendientes","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseOccurrenceDto"}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/componentes":{"get":{"tags":["Componentes del humedal"],"summary":"Listar componentes del humedal","description":"Público. Devuelve siempre los cuatro componentes (INSECTOS, AVES, FLORA, OTROS), en ese orden. Los que aún no tienen información traen tieneContenido=false y el cliente muestra: 'La información de esta sección estará disponible próximamente.'","operationId":"listar_1","responses":{"200":{"description":"Listado de componentes","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ComponentDto"}}}}}},"security":[]}},"/api/autenticacion/yo":{"get":{"tags":["Autenticación"],"summary":"Usuario de la sesión actual","description":"Devuelve los datos y el rol del dueño del token; útil para restaurar la sesión en el cliente.","operationId":"obtenerUsuarioActual","responses":{"200":{"description":"Usuario autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthenticatedUserDto"}}}},"401":{"description":"Token ausente, inválido o vencido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/administradores":{"get":{"tags":["Administradores"],"summary":"Listar administradores y superadministradores","description":"Solo SUPERADMINISTRADOR. Devuelve las cuentas con rol ADMINISTRADOR o SUPERADMINISTRADOR, incluidas las inhabilitadas, ordenadas por nombre y apellido.","operationId":"listar_2","responses":{"200":{"description":"Listado de administradores (vacío si no hay ninguno)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AdministratorDto"}}}}},"401":{"description":"Sin sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}},"403":{"description":"El usuario no es superadministrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiErrorResponse"}}}}}}},"/api/componentes/{tipo}/fotos/{idFoto}":{"delete":{"tags":["Componentes del humedal"],"summary":"Eliminar una foto de un componente","description":"Solo ADMINISTRADOR o SUPERADMINISTRADOR. El id de la foto viene en la lista 'fotos' del componente.","operationId":"eliminarFot